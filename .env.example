# Relational database: Neon PostgreSQL
DATABASE_URL="postgres://user:password@ep-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgres://user:password@ep-direct.region.aws.neon.tech/dbname?sslmode=require"

# Redis: Upstash Redis Free (TCP/TLS)
REDIS_URL="rediss://default:password@region.upstash.io:6379"

# Object storage: Neon Object Storage (S3-compatible)
STORAGE_BUCKET="avenor-media"
STORAGE_REGION="us-east-2"
STORAGE_ENDPOINT="https://<endpoint>.neon.tech"
STORAGE_ACCESS_KEY="nak_live_..."
STORAGE_SECRET_KEY="nsk_live_..."
STORAGE_PUBLIC_URL_BASE=""

# Backward-compatible S3 variables
S3_BUCKET="avenor-media"
S3_REGION="us-east-2"
S3_ENDPOINT="https://<endpoint>.neon.tech"
S3_ACCESS_KEY="nak_live_..."
S3_SECRET_KEY="nsk_live_..."
S3_PUBLIC_URL_BASE=""

# Application secrets and environment
APP_ENV="development"
NODE_ENV="development"
SITE_URL="http://localhost:3000"
AUTH_SECRET="change-this-to-a-secure-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
LIKE_HASH_SECRET="change-this-to-a-secure-random-secret"

# Admin seed
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="a-secure-temporary-password"

# Email
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
EMAIL_FROM="notifications@example.com"
